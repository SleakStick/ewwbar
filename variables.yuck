(defvar audio-control_up "false")
(defvar media-player_up "false")
(defvar system-control_up "false")
(defvar bluetooth-control_up "false")
(defvar network-control_up "false")
(defvar window_up "false")
(defvar show_bar "false")
(defpoll monitors :interval "15s" :initial "[]"
       "hyprctl -j monitors | jq -c '[.[].name]'")
(deflisten media-player_artPath :initial "./resources/placeholder.jpg"
  "./scripts/image-fetcher.sh")
(defvar force_show_bar "false")
(defpoll media-player_currentVolume :interval "1s" :initial 100
"pactl --format=json list sinks | jq --arg key 'front-left' --arg default_name $(pactl get-default-sink) '.[] | select(.name == $default_name) | .volume.[$key].value_percent' | sed 's/[^0-9]//g'")
(defpoll media-player_currentTitle :interval "1s"
  "playerctl metadata --format '{{title}} - {{artist}}'")
(deflisten media-player_status :initial "false"
  "playerctl status --follow")

(deflisten bar_workspaces :initial '[{"err":"err"}]'
  "stdbuf -oL ./scripts/workspaces-fetcher.sh")
(defpoll bar_batteryInfo :interval "10s" :initial '[{"err":"err"}]'
  "./scripts/battery-info.sh")
(defvar bar_power-profiles-order '[{"power-saver":"balanced", "balanced":"performance", "performance":"power-saver"}]')

(defpoll time :interval "1s"
  'date +%H:%M:%S')

(deflisten audio-control_info :initial '{"sinks": [], "sources": []}'
  "./scripts/audio-control.sh")
(defpoll audio-control_currentSink :interval "1s"
  "./scripts/audio-control.sh current_sink")

(defpoll bluetooth-control_devicesPoll :interval "2s" :initial "{}" 
  "./scripts/bluetooth-control.sh poll_devices")
(defpoll bluetooth-control_controllerPoll :interval "500s" :initial "{}"
  "./scripts/bluetooth-control.sh poll_controller") 
(defpoll bluetooth-control_scan_button :initial "Scan" :interval "200ms"
         "bluetoothctl show | grep -q 'Discovering: yes' && echo Scanning... || echo Scan")
(defvar bluetooth-control_menuVisible false)
(defvar bluetooth-control_selectedDevice "{}")

(defpoll network-control_knownNetworks :interval "24h" :initial '["err"]'
  "./scripts/network-control.sh known_networks")
(defpoll network-control_unknownNetworks :interval "24h" :initial '["err"]'
  "./scripts/network-control.sh unknown_networks")
(defpoll network-control_currentNetwork :interval "1h" :initial '["err"]'
  "./scripts/network-control.sh current_network")
(defvar network-control_controlWidgetReavealer false)
(defvar network-control_knownControlWidgetReavealer false)
(defvar network-control_unknownControlWidgetReavealer false)
(defvar network-control_controlWidgetInfo "")
(defvar network-control_onOffButton "Turn off")
(defvar network-control_scanButton "Scan")

(defpoll bar_bluetoothIcon :initial "" :interval "2s"
  "./scripts/bar_symbols.sh bluetooth")
(defpoll bar_audioControlIcon :initial "" :interval "2s"
  "./scripts/bar_symbols.sh audio_control")

(defpoll system-control_info :initial '{"sinks": [], "sources": []}' :interval "1s"
  "./scripts/system-control.sh sysinfo")
(defvar system-control_inhibit-sleep false)

(defvar backgroundColor "#33adcc")
(defvar accentColor "#33adcc")
