(defwidget bluetooth-control_mainWidget[]
  (box :class "bluetooth-control_mainContainer" :orientation "horizontal" :halign "end" :space-evenly false
   (box :class "bluetooth-control_contentContainer" :orientation "horizontal" :halign "end" :space-evenly false
    (box :class "bluetooth-control_devicesContainer" :orientation "vertical" :halign "center" :space-evenly false

       (box :class "bluetooth-control_headerContainer" :orientation "horizontal" 
            (button :class "bluetooth-control_headerButton" :onclick "./scripts/bluetooth-control.sh toggle_power" :timeout "5s" 
                    (label :text "${bluetooth-control_controllerPoll.power_button}"))
            (button :class "bluetooth-control_headerButton" :onclick "./scripts/bluetooth-control.sh toggle_scan" :timeout "11s"
                    (label :text "${bluetooth-control_scan_button}")))

       (box :orientation "vertical" :space-evenly false
       (box :class "bluetooth-control_infoContainer" :orientation "vertical" :space-evenly false
       (box :orientation "horizontal"
       (box :class "bluetooth-control_knownDevices" :orientation "horizontal" 
            (box :class "bluetooth-control_connectedDevices" :orientation "vertical" :valign "start" :halign "center" :vexpand true
                 (label :class "bluetooth-control_text" :text "Connected")
                 (for device in "${bluetooth-control_devicesPoll.connected}"
                        (button :class "bluetooth-control_button" 
                                :onclick  "eww open bluetooth-control_device_Window && eww update bluetooth-control_selectedDevice='${device}' && eww update bluetooth-control_deviceKnown=true && eww update bluetooth-control_device_menu_button='Disconnect'"
                                (label :class "bluetooth-control_buttonText" :text "${device.name} / ${device.battery}%"))))
            (box :class "bluetooth-control_pairedDevices" :orientation "vertical" :valign "start" :halign "center" :vexpand true
                 (label :class "bluetooth-control_text" :text "Paired")
                 (for device in "${bluetooth-control_devicesPoll.paired}"
                        (button :class "bluetooth-control_button" 
                                :onclick  "eww update bluetooth-control_selectedDevice='${device}' && eww open bluetooth-control_device_Window && eww update bluetooth-control_deviceKnown=true && eww update bluetooth-control_device_menu_button='Connect'"
                                (label :class "bluetooth-control_buttonText" :text "${device.name}"))))))
       (box :class "bluetooth-control_nearbyDevices" :orientation "vertical"
            (label :class "bluetooth-control_text" :text "Nearby Devices")
            (box :orientation "vertical" 
                    (for device in "${bluetooth-control_devicesPoll.devices}"
                        (button :class "bluetooth-control_button" 
                                :onclick "eww open bluetooth-control_device_Window && eww update bluetooth-control_selectedDevice='${device}' && eww update bluetooth-control_deviceKnown=false && eww update bluetooth-control_device_menu_button='Connect'"
                                (label :class "bluetooth-control_buttonText" :text "${device.name}"))))))
;    (box :hexpand true :space-evenly true :halign "center"
;    (revealer :reveal bluetooth-control_menuVisible :visible bluetooth-control_menuVisible :transition "slideleft" :duration "1s"
;    (eww open --toggle bluetooth-control_deviceMenu :device blueto"Timoth-control_selectedDevice)))

)))))

(defwidget bluetooth-control_deviceMenu [device]
  (box :orientation "v" :class "bluetooth-control_deviceMenu" :halign "start" :hexpand false 
    (box :class "bluetooth-control_selectedDeviceBox"
    (label :class "bluetooth-control-selectedDeviceName" :text "${device.name}"))
    (button :class "bluetooth-control_button" :timeout "10s"
            :onclick "exec ./scripts/bluetooth-control.sh -m '${device}' ${'${device.connected}' ? '-d' : ('${bluetooth-control_deviceKnown}' ? '-c' : '-a')} && eww close bluetooth-control_device_Window" 
            "${bluetooth-control_device_menu_button}")
    (box :visible "${bluetooth-control_deviceKnown}"
    (button :class "bluetooth-control_button"
            :onclick "exec ./scripts/bluetooth-control.sh -m '${device}' -f && eww close bluetooth-control_device_Window"
            "Forget"))
    (button :class "bluetooth-control_button" 
            :onclick "eww close bluetooth-control_device_Window" 
            "")))

