(defwidget powerprofile_mainWidget []
           (box :class "powerprofile_mainBox"
                :orientation "vertical"
                (scale :draw-value false
                       :valign "center"
                       :class "powerprofile-slider"
                       :orientation "horizontal"
                       :flipped false
                       :min 1 :max 4
                       :onchange "./scripts/power-profiles-switcher.sh switch {} && eww update "
                       :timeout "4s"
                       :value "${powerprofile}")
                (box :class "powerprofile_indicatorBox" :orientation "horizontal" :halign "fill" :space-evenly true
                     (box :class "powerprofile_powerSaverText" "")
                     (box :class "powerprofile_balancedText" "")
                     (box :class "powerprofile_performanceText" "")
                     )))

